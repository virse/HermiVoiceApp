<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Installation der per SHA-256 geprüften Update-APK (Android 8+). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:name=".HermiApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.HermiVoice">

        <activity
            android:name=".SplashActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.HermiVoice">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="de.hermi.voice.HermiFileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <!-- Zugriff nur auf das Cache-Verzeichnis (Export-Empfänger darf die
                 temporäre .md-Datei lesen; der Cache wird vom System geräumt). -->
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Teile-Schleuse (Variante B): nimmt "Senden mit/Teilen mit" (ACTION_SEND,
             text/plain) entgegen, reicht den Text als Extra an MainActivity weiter und
             beendet sich sofort. Nur diese eine Activity ist exported=true - der Chat
             selbst bleibt exported=false. transparent + excludeFromRecents: kein
             UI-Blinken, kein Eintrag in der Übersicht. -->
        <activity
            android:name=".ShareActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.HermiVoice.Transparent">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- singleTop: Wenn die App bereits läuft, wird beim erneuten Teilen
             onNewIntent aufgerufen statt eine zweite Instanz zu erzeugen. -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <!-- Hält den Prozess während einer Streaming-Antwort am Leben (Hintergrund). -->
        <service
            android:name=".StreamKeepAliveService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <!-- Einstellungs-Sub-Screens (Hauptkategorien) -->
        <activity
            android:name=".settings.CredentialsActivity"
            android:exported="false"
            android:parentActivityName=".SettingsActivity" />
        <activity
            android:name=".settings.BotsActivity"
            android:exported="false"
            android:parentActivityName=".SettingsActivity" />
        <activity
            android:name=".settings.CloudProvidersActivity"
            android:exported="false"
            android:parentActivityName=".SettingsActivity" />
        <activity
            android:name=".settings.SttModelActivity"
            android:exported="false"
            android:parentActivityName=".SettingsActivity" />
        <activity
            android:name=".settings.ChatModelActivity"
            android:exported="false"
            android:parentActivityName=".SettingsActivity" />
        <activity
            android:name=".settings.ReasoningActivity"
            android:exported="false"
            android:parentActivityName=".SettingsActivity" />
        <activity
            android:name=".settings.AppearanceActivity"
            android:exported="false"
            android:parentActivityName=".SettingsActivity" />
        <activity
            android:name=".settings.AccentChatBgActivity"
            android:exported="false"
            android:parentActivityName=".SettingsActivity" />
        <activity
            android:name=".settings.AvatarsActivity"
            android:exported="false"
            android:parentActivityName=".SettingsActivity"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".settings.NotificationActivity"
            android:exported="false"
            android:parentActivityName=".SettingsActivity" />
        <activity
            android:name=".settings.AutoSessionActivity"
            android:exported="false"
            android:parentActivityName=".SettingsActivity" />
        <activity
            android:name=".settings.LanguageActivity"
            android:exported="false"
            android:parentActivityName=".SettingsActivity" />
        <activity
            android:name=".settings.TuningActivity"
            android:exported="false"
            android:parentActivityName=".SettingsActivity" />
        <activity
            android:name=".settings.UpdateBackupActivity"
            android:exported="false"
            android:parentActivityName=".SettingsActivity" />
    </application>
</manifest>
