<?xml version="1.0" encoding="utf-8"?>
<!-- FileProvider-Pfade für den Session-Export: nur das App-eigene
     Cache-Verzeichnis ist für Share-Ziele lesbar (temporäre .md-Datei). -->
<paths>
    <cache-path name="export" path="." />
    <!-- Ziel von DownloadManager.setDestinationInExternalFilesDir(..., DIRECTORY_DOWNLOADS, ...) -->
    <external-files-path name="updates" path="Download/" />
</paths>