<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/sectionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:textColor="?attr/colorAccent"
            android:textSize="22sp"
            android:textStyle="bold" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/showSeparatorSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="8dp"
            android:text="@string/show_separator_label"
            android:textColor="@color/text_primary"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/show_separator_hint"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:lineSpacingExtra="1dp" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/hapticFeedbackSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:paddingVertical="8dp"
            android:text="@string/haptic_feedback_switch_label"
            android:textColor="@color/text_primary"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/haptic_feedback_switch_hint"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:lineSpacingExtra="1dp" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/ttsReadAnswerSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:paddingVertical="8dp"
            android:text="@string/tts_read_answer_label"
            android:textColor="@color/text_primary"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/tts_read_answer_hint"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:lineSpacingExtra="1dp" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/startInputModeSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:paddingVertical="8dp"
            android:text="@string/start_input_mode_label"
            android:textColor="@color/text_primary"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/start_input_mode_hint"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:lineSpacingExtra="1dp" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/keyboardAfterAnswerSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:paddingVertical="8dp"
            android:text="@string/keyboard_after_answer_label"
            android:textColor="@color/text_primary"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/keyboard_after_answer_hint"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:lineSpacingExtra="1dp" />

    </LinearLayout>
</ScrollView>