<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/sectionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:textColor="?attr/colorAccent"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/tuning_section_hint"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:lineSpacingExtra="2dp" />

        <!-- Regler 1: Empfindlichkeit (Gain) -->
        <TextView
            android:id="@+id/micGainValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/mic_sensitivity_label"
            android:textColor="@color/text_primary"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/mic_sensitivity_hint"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:lineSpacingExtra="2dp" />

        <SeekBar
            android:id="@+id/micGainSlider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:max="110"
            android:progressTint="?attr/colorAccent"
            android:thumbTint="?attr/colorAccent" />

        <!-- Regler 2: Min. Nachlauf -->
        <TextView
            android:id="@+id/tailMinValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/tail_min_label"
            android:textColor="@color/text_primary"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/tail_min_hint"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:lineSpacingExtra="1dp" />

        <SeekBar
            android:id="@+id/tailMinSlider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:max="20"
            android:progressTint="?attr/colorAccent"
            android:thumbTint="?attr/colorAccent" />

        <!-- Regler 3: Stille‑Dauer -->
        <TextView
            android:id="@+id/silenceBlocksValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/silence_blocks_label"
            android:textColor="@color/text_primary"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/silence_blocks_hint"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:lineSpacingExtra="1dp" />

        <SeekBar
            android:id="@+id/silenceBlocksSlider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:max="15"
            android:progressTint="?attr/colorAccent"
            android:thumbTint="?attr/colorAccent" />

        <!-- Regler 4: Max. Nachlauf -->
        <TextView
            android:id="@+id/tailMaxValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/tail_max_label"
            android:textColor="@color/text_primary"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/tail_max_hint"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:lineSpacingExtra="1dp" />

        <SeekBar
            android:id="@+id/tailMaxSlider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:max="80"
            android:progressTint="?attr/colorAccent"
            android:thumbTint="?attr/colorAccent" />

        <!-- Regler 5: Stille‑Schwelle (relativ) -->
        <TextView
            android:id="@+id/silenceFactorValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/silence_factor_label"
            android:textColor="@color/text_primary"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/silence_factor_hint"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:lineSpacingExtra="1dp" />

        <SeekBar
            android:id="@+id/silenceFactorSlider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:max="100"
            android:progressTint="?attr/colorAccent"
            android:thumbTint="?attr/colorAccent" />

        <!-- Regler 6: Stille‑Schwelle (absolut) -->
        <TextView
            android:id="@+id/silenceFloorValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/silence_floor_label"
            android:textColor="@color/text_primary"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/silence_floor_hint"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:lineSpacingExtra="1dp" />

        <SeekBar
            android:id="@+id/silenceFloorSlider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:max="100"
            android:progressTint="?attr/colorAccent"
            android:thumbTint="?attr/colorAccent" />

        <Button
            android:id="@+id/resetDefaultsButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/reset_defaults" />

    </LinearLayout>
</ScrollView>