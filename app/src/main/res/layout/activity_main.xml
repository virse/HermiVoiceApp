<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <!-- ================= Header-Bar: Logo + App-Name + Version + Aktionen ================= -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/headerBar"
        android:layout_width="match_parent"
        android:layout_height="88dp"
        android:background="@color/header_bg"
                android:paddingStart="0dp"
                android:paddingTop="10dp"
                android:paddingEnd="0dp"
                android:paddingBottom="10dp"
                android:clipChildren="false">
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Logo (das App-Icon), links -->
        <ImageButton
            android:id="@+id/menuButton"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/history"
            android:src="@drawable/ic_menu"
            app:tint="@color/text_primary"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- Logo (das App-Icon): ein grünes Mikrofon in einem 108dp-Canvas mit viel Leerraum.
             Skalierung centerCrop + feste Größe, damit das sichtbare Zeichen selbst die
             Textblockhöhe (Titel+Version) füllt und vertikal auf den Textblock zentriert ist. -->
        <ImageView
            android:id="@+id/logoImage"
            android:layout_width="48dp"
            android:layout_height="0dp"
            android:layout_marginStart="13dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_logo_header"
            app:layout_constraintTop_toTopOf="@id/headerTextBlock"
            app:layout_constraintBottom_toBottomOf="@id/headerTextBlock"
            app:layout_constraintStart_toEndOf="@id/menuButton" />

        <!-- Textblock: App-Name oben, Version darunter -->
        <LinearLayout
            android:id="@+id/headerTextBlock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:orientation="vertical"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/logoImage">

            <TextView
                android:id="@+id/appTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical|start"
                android:includeFontPadding="false"
                android:text="@string/app_title"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:textStyle="bold"
                android:ellipsize="end"
                android:maxLines="1" />

            <TextView
                android:id="@+id/appVersion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical|start"
                android:includeFontPadding="false"
                android:text="@string/app_version_prefix"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Tastatur-Toggle (interner Block 3: direkt nach Einstellung, 2dp) -->
                <ImageButton
                    android:id="@+id/keyboardToggle"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="2dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/keyboard_toggle_open"
                    android:src="@drawable/ic_keyboard"
                    app:tint="@color/text_primary"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toEndOf="@id/settingsButton"
                    app:layout_constraintBottom_toBottomOf="parent" />

        <!-- Einstellungen (Block 3: nach dem Textblock, Lücke 13dp) -->
        <ImageButton
            android:id="@+id/settingsButton"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="13dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/settings"
            android:src="@drawable/ic_settings"
            app:tint="@color/text_primary"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toEndOf="@id/headerTextBlock"
                        app:layout_constraintBottom_toBottomOf="parent" />

                    <!-- Bot-Wechsel: Dropdown (Block 4, nach Tastatur, Lücke 13dp). -->
                            <Spinner
                                android:id="@+id/botSpinner"
                                android:layout_width="90dp"
                                android:layout_height="44dp"
                                android:layout_marginStart="13dp"
                                android:background="@drawable/input_bg_drawable"
                                android:paddingStart="10dp"
                                android:paddingEnd="10dp"
                                android:contentDescription="@string/bot_spinner_desc"
                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintStart_toEndOf="@id/keyboardToggle"
                                app:layout_constraintBottom_toBottomOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ================= Statuszeile: Punkt vertikal zentriert zum Text ================= -->
    <LinearLayout
        android:id="@+id/statusRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_weight="0"
        app:layout_constraintTop_toBottomOf="@id/headerBar"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/statusDot"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:background="@drawable/circle"
            app:backgroundTint="?attr/colorAccent" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="@string/state_ready"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Modell-Anzeige: rechts neben dem Bearbeitungsstatus, real genutztes
         Paar (primär ODER Fallback) nach dem letzten Austausch (Q2/c). -->
    <TextView
        android:id="@+id/statusModel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingStart="12dp"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        app:layout_constraintBottom_toBottomOf="@id/statusRow"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/statusRow"
        app:layout_constraintTop_toTopOf="@id/statusRow" />

    <!-- ================= Konversation: scrollbarer Verlauf ================= -->
    <ScrollView
        android:id="@+id/chatScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:fillViewport="true"
        android:focusable="false"
        android:focusableInTouchMode="false"
        app:layout_constraintTop_toBottomOf="@id/statusRow"
        app:layout_constraintBottom_toTopOf="@id/bottomHost"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/chatContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <!-- ================= Untere Leiste: Aufnahme unten, Tastatureingabe an DERSELBEN Stelle ================= -->
    <FrameLayout
        android:id="@+id/bottomHost"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Push-to-talk Button (Spracheingabe, Standard) -->
        <!-- v1.17: Kein <Button> -> im Material3-Theme wird daraus ein MaterialButton,
             der seinen eigenen MaterialShapeDrawable-Hintergrund + Theme-Tint
             (colorSurfaceContainer) zeichnet und android:background ignoriert.
             Voll qualifizierter android.widget.Button verhindert die Material-
             Auto-Inflation; backgroundTint=@null hebt den Theme-Tint auf. -->
        <android.widget.Button
            android:id="@+id/recordButton"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:background="@drawable/record_button_bg"
            android:backgroundTint="@null"
            android:text="@string/hold_to_talk"
            android:textColor="#ffffff"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Tastatureingabe: ersetzt den Aufnahme-Button, gleiche Position -->
        <LinearLayout
            android:id="@+id/inputRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="bottom"
            android:visibility="gone">

            <!-- Mehrzeilig + mitwachsend: minLines 1, wächst bis maxLines 4.
                 Enter fügt einen Zeilenumbruch ein (Senden über sendButton). -->
            <EditText
                android:id="@+id/inputField"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/input_bg_drawable"
                android:gravity="bottom|start"
                android:hint="@string/keyboard_input_hint"
                android:imeOptions="flagNoEnterAction"
                android:inputType="textMultiLine"
                android:minLines="1"
                android:maxLines="4"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:textSize="16sp" />

            <!-- Einfügen-Button: hängt den zuletzt kopierten Text (URL, Meldung,
                 langer Text) an das Eingabefeld an, statt ihn einzutippen. -->
            <ImageButton
                android:id="@+id/pasteButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/input_bg_drawable"
                android:contentDescription="@string/paste_clipboard"
                android:src="@drawable/ic_clipboard"
                app:tint="?attr/colorControlNormal" />

            <ImageButton
                android:id="@+id/sendButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/input_bg_drawable"
                android:contentDescription="@string/send"
                android:src="@drawable/ic_send"
                app:backgroundTint="?attr/colorAccent"
                app:tint="#ffffff" />
        </LinearLayout>
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>